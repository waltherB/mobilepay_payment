<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        All templates here extend AbstractAwaitablePopup, which renders a
        standard POS popup wrapper. The root element for popup content is
        the <div class="popup"> block expected by the POS popup service.
    -->

    <!-- ================================================================
         MobilePayModePopup
         Operator chooses Phone Push or QR Code.
    ================================================================ -->
    <t t-name="mobilepay_payment.MobilePayModePopup" owl="1">
        <div class="popup mobilepay-mode-popup">
            <div class="title" t-esc="props.title"/>
            <div class="body d-flex flex-column align-items-center gap-3 p-3">

                <p class="text-muted text-center mb-2">
                    How should the customer pay?
                </p>

                <!-- Phone Push -->
                <button
                    class="btn btn-primary btn-lg w-100 d-flex align-items-center gap-3"
                    t-on-click="selectPhonePush">
                    <i class="fa fa-mobile fa-2x"/>
                    <div class="text-start">
                        <div class="fw-bold">Send Push to Phone</div>
                        <small class="text-white-50">
                            Customer receives a notification in their MobilePay app
                        </small>
                    </div>
                </button>

                <!-- QR Code -->
                <button
                    class="btn btn-secondary btn-lg w-100 d-flex align-items-center gap-3"
                    t-on-click="selectQr">
                    <i class="fa fa-qrcode fa-2x"/>
                    <div class="text-start">
                        <div class="fw-bold">Show QR Code</div>
                        <small class="text-muted">Customer scans a QR code on screen</small>
                    </div>
                </button>

            </div>
            <div class="footer d-flex justify-content-end">
                <button class="btn btn-outline-secondary" t-on-click="props.close">
                    Cancel
                </button>
            </div>
        </div>
    </t>

    <!-- ================================================================
         MobilePayPhonePopup
         Capture customer phone number before push payment.
    ================================================================ -->
    <t t-name="mobilepay_payment.MobilePayPhonePopup" owl="1">
        <div class="popup mobilepay-phone-popup">
            <div class="title" t-esc="props.title"/>
            <div class="body d-flex flex-column align-items-center gap-3 p-3">

                <!-- Phone display -->
                <div class="w-100 text-center border rounded py-2 bg-light">
                    <span class="fs-2 fw-bold font-monospace" t-esc="state.phone || '—'"/>
                </div>

                <!-- Numeric keypad -->
                <div
                    class="d-grid gap-2"
                    style="grid-template-columns: repeat(3, 1fr); width: 280px;">
                    <t t-foreach="['1','2','3','4','5','6','7','8','9','+','0','⌫']"
                       t-as="digit"
                       t-key="digit">
                        <button
                            class="btn btn-outline-secondary btn-lg fs-4"
                            t-on-click="() => digit === '⌫' ? deleteLast() : appendDigit(digit)"
                            t-esc="digit"/>
                    </t>
                </div>

            </div>
            <div class="footer d-flex gap-2 justify-content-end">
                <button class="btn btn-outline-secondary" t-on-click="cancel">
                    Cancel
                </button>
                <button
                    class="btn btn-primary"
                    t-att-disabled="!state.phone"
                    t-on-click="confirm">
                    Send Push
                </button>
            </div>
        </div>
    </t>

    <!-- ================================================================
         MobilePayQrPopup
         QR code display with countdown, status text, and fallback actions.
    ================================================================ -->
    <t t-name="mobilepay_payment.MobilePayQrPopup" owl="1">
        <div class="popup mobilepay-qr-popup">
            <div class="title" t-esc="props.title"/>
            <div class="body d-flex flex-column align-items-center gap-3 p-3">

                <!-- QR Image -->
                <div class="border rounded p-2 bg-white">
                    <img
                        t-att-src="qrSrc"
                        alt="MobilePay QR Code"
                        style="width: 240px; height: 240px; object-fit: contain;"/>
                </div>

                <!-- Status text -->
                <p class="text-center text-muted mb-0" t-esc="state.statusText"/>

                <!-- Countdown badge -->
                <span
                    t-attf-class="badge fs-6 {{
                        remaining > 15 ? 'bg-secondary' :
                        remaining > 5  ? 'bg-warning text-dark' :
                                         'bg-danger'
                    }}">
                    <i class="fa fa-clock-o me-1"/>
                    <t t-esc="remaining"/>s
                </span>

            </div>
            <div class="footer d-flex gap-2 flex-wrap justify-content-between">
                <button
                    class="btn btn-outline-primary"
                    t-on-click="switchToPhone">
                    <i class="fa fa-mobile me-1"/>
                    Switch to Phone Push
                </button>
                <button
                    class="btn btn-outline-danger"
                    t-on-click="cancelPayment">
                    <i class="fa fa-times me-1"/>
                    Cancel Payment
                </button>
            </div>
        </div>
    </t>

    <!-- ================================================================
         MobilePayErrorPopup
         Simple error display used as a fallback when ErrorPopup
         is not directly importable.
    ================================================================ -->
    <t t-name="mobilepay_payment.MobilePayErrorPopup" owl="1">
        <div class="popup mobilepay-error-popup">
            <div class="title" t-esc="props.title"/>
            <div class="body text-center p-3">
                <i class="fa fa-exclamation-triangle text-danger fa-2x mb-3"/>
                <p t-esc="props.body"/>
            </div>
            <div class="footer d-flex justify-content-end">
                <button class="btn btn-primary" t-on-click="props.close">OK</button>
            </div>
        </div>
    </t>

</templates>
