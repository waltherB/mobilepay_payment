<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cron for MobilePay Transaction Status Polling -->
        <record id="ir_cron_mobilepay_status_poll" model="ir.cron">
            <field name="name">MobilePay: Poll Payment Status</field>
            <field name="model_id" ref="model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model.search([('provider_id.code', '=', 'mobilepay'), ('state', 'in', ['draft', 'pending'])])._mobilepay_retry_poll_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
