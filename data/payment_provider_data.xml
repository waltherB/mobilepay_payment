<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- MobilePay Payment Provider -->
        <record id="payment_provider_mobilepay" model="payment.provider">
            <field name="name">MobilePay</field>
            <field name="image_128" type="base64" file="mobilepay_payment/static/description/icon.svg"/>
            <field name="code">mobilepay</field>
            <field name="state">disabled</field>
            <field name="is_published" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="capture_manually" eval="True"/>
            <field name="capture_on_delivery" eval="False"/>
            <field name="auto_capture_delay">24</field>
            <field name="support_manual_capture">partial</field>
            <field name="support_refund">partial</field>
            <field name="inline_form_view_id" ref="mobilepay_inline_form"/>
            <field name="redirect_form_view_id" ref="mobilepay_redirect_form"/>
        </record>

        <!-- MobilePay Payment Method -->
        <record id="payment_method_mobilepay" model="payment.method">
            <field name="name">MobilePay</field>
            <field name="code">mobilepay</field>
            <field name="sequence">10</field>
            <field name="image" type="base64" file="mobilepay_payment/static/description/icon.svg"/>
            <field name="provider_ids" eval="[(4, ref('payment_provider_mobilepay'))]"/>
            <field name="supported_country_ids" eval="[(4, ref('base.dk'))]"/>
            <field name="supported_currency_ids" eval="[(4, ref('base.DKK'))]"/>
        </record>

    </data>
</odoo>