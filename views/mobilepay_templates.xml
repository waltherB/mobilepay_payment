<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mobilepay_inline_form">
        <div class="o_payment_mobilepay_inline_form mt-2 mb-2">
            <!-- Branding Header -->
            <div class="d-flex align-items-center mb-3">
                <img t-att-src="'/mobilepay_payment/static/img/mobilepay_logo.svg'" alt="MobilePay Logo" style="height: 24px; width: auto; margin-right: 10px;"/>
                <span class="text-muted">Pay with Vipps or MobilePay</span>
            </div>
            
            <label t-attf-for="mobilepay_phone_#{provider_id}" class="col-form-label">Phone Number</label>
            <input type="text" 
                   name="mobilepay_phone" 
                   t-attf-id="mobilepay_phone_#{provider_id}" 
                   class="form-control" 
                   placeholder="Phone number with country code"
                   inputmode="tel"
                   autocomplete="tel"
                   t-att-value="((request.website.sale_get_order() and (request.website.sale_get_order().partner_id.phone or request.website.sale_get_order().partner_id.mobile)) or (request.env.user.partner_id.phone or request.env.user.partner_id.mobile))"/>
            <small class="form-text text-muted">Enter your Vipps or MobilePay phone number with country code, or leave it blank. Local numbers use your billing country.</small>
        </div>
    </template>

    <template id="mobilepay_redirect_form">
        <form t-att-action="api_url" method="get" target="_top">
            <t t-foreach="redirect_params" t-as="param">
                <input type="hidden" t-att-name="param[0]" t-att-value="param[1]"/>
            </t>
        </form>
    </template>
</odoo>
