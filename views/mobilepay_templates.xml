<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mobilepay_inline_form">
        <t t-set="mobilepay_brand" t-value="provider_sudo._mobilepay_checkout_branding()"/>
        <div class="o_payment_mobilepay_inline_form mt-2 mb-2">
            <!-- Branding Header -->
            <div class="d-flex align-items-center mb-3">
                <img t-att-src="mobilepay_brand['logo']" t-att-alt="mobilepay_brand['name']" style="height: 32px; width: auto; margin-right: 10px;"/>
                <span class="text-muted" t-out="mobilepay_brand['payment_label']"/>
            </div>
            
            <label t-attf-for="mobilepay_phone_#{provider_id}" class="col-form-label">Phone Number</label>
            <input type="text" 
                   name="mobilepay_phone" 
                   t-attf-id="mobilepay_phone_#{provider_id}" 
                   class="form-control" 
                   placeholder="Phone number with country code"
                   inputmode="tel"
                   autocomplete="tel"
                   t-att-value="((request.website.sale_get_order() and (request.website.sale_get_order().partner_id.phone or request.website.sale_get_order().partner_id.mobile)) or (request.env.user.partner_id.phone or request.env.user.partner_id.mobile))"/>
            <small class="form-text text-muted">Enter your Vipps or MobilePay phone number with country code, or leave it blank. Local numbers use your billing country.</small>
        </div>
    </template>

    <template id="mobilepay_method_branding" inherit_id="payment.method_form">
        <xpath expr="//label[@t-out='pm_sudo.name']" position="attributes">
            <attribute name="t-out">provider_sudo._mobilepay_checkout_branding()['name'] if provider_sudo.code == 'mobilepay' else pm_sudo.name</attribute>
        </xpath>
        <xpath expr="//t[@t-call='payment.form_logo']" position="attributes">
            <attribute name="t-call">{{'mobilepay_payment.mobilepay_market_logo' if provider_sudo.code == 'mobilepay' else 'payment.form_logo'}}</attribute>
        </xpath>
        <xpath expr="//p[@name='o_payment_secured_by']/span[@t-out]" position="attributes">
            <attribute name="t-out">provider_sudo._mobilepay_checkout_branding()['name'] if provider_sudo.code == 'mobilepay' else dict(provider_sudo._fields['code']._description_selection(provider_sudo.env))[provider_sudo.code]</attribute>
        </xpath>
    </template>

    <template id="mobilepay_market_logo">
        <t t-set="mobilepay_brand" t-value="provider_sudo._mobilepay_checkout_branding()"/>
        <img t-att-src="mobilepay_brand['logo']"
             t-att-alt="mobilepay_brand['name']"
             t-att-title="mobilepay_brand['name']"
             class="position-relative d-block"
             style="height: 30px; width: auto;"/>
    </template>

    <template id="mobilepay_redirect_form">
        <form t-att-action="api_url" method="get" target="_top">
            <t t-foreach="redirect_params" t-as="param">
                <input type="hidden" t-att-name="param[0]" t-att-value="param[1]"/>
            </t>
        </form>
    </template>
</odoo>
