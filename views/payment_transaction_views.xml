<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- MobilePay Payment Transaction Form View -->
        <record id="payment_transaction_form_mobilepay" model="ir.ui.view">
            <field name="name">payment.transaction.form.mobilepay</field>
            <field name="model">payment.transaction</field>
            <field name="inherit_id" ref="payment.payment_transaction_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='provider_id']" position="after">
                    <field name="show_mobilepay_fields" invisible="1"/>

                    <!--
                        Two-column group for amounts + status.
                        These are short values so nested <group> works fine.
                    -->
                    <group name="mobilepay_details"
                           string="MobilePay Details"
                           invisible="not show_mobilepay_fields">
                        <group name="mobilepay_amounts" string="Amounts">
                            <field name="authorized_amount"/>
                            <field name="captured_amount"/>
                            <field name="refunded_amount"/>
                            <field name="capture_eligible"/>
                        </group>
                        <group name="mobilepay_status_group" string="Status">
                            <field name="mobilepay_status"/>
                            <field name="last_status_poll"/>
                        </group>
                    </group>
                </xpath>

                <!--
                    Inject a notebook page for the long ID / key values.
                    A notebook page gives each field the full sheet width,
                    guaranteed to never wrap character-by-character.
                    We insert it before any existing notebook so it appears first.
                -->
                <xpath expr="//notebook" position="before">
                    <notebook invisible="not show_mobilepay_fields">
                        <page string="MobilePay IDs" name="mobilepay_ids">
                            <group>
                                <field name="mobilepay_payment_id"
                                       readonly="1"/>
                                <field name="mobilepay_idempotency_key"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>

                <!-- Stat button: Fetch Event Log -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_fetch_mobilepay_event_log"
                            type="object"
                            string="Fetch Event Log"
                            icon="fa-history"
                            invisible="not show_mobilepay_fields"
                            class="oe_stat_button"
                            help="Fetch the full payment event history from MobilePay and add it to the chatter"/>
                </xpath>

            </field>
        </record>

        <!-- MobilePay Payment Transaction List View -->
        <record id="payment_transaction_tree_mobilepay" model="ir.ui.view">
            <field name="name">payment.transaction.tree.mobilepay</field>
            <field name="model">payment.transaction</field>
            <field name="inherit_id" ref="payment.payment_transaction_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='reference']" position="after">
                    <field name="show_mobilepay_fields" column_invisible="True"/>
                    <field name="mobilepay_payment_id"
                           invisible="not show_mobilepay_fields"/>
                    <field name="mobilepay_status"
                           invisible="not show_mobilepay_fields"
                           widget="badge"
                           decoration-success="mobilepay_status == 'CAPTURED'"
                           decoration-warning="mobilepay_status in ('RESERVED', 'AUTHORIZED')"
                           decoration-danger="mobilepay_status in ('CANCELLED', 'ABORTED', 'TERMINATED', 'EXPIRED')"/>
                </xpath>
            </field>
        </record>

        <!-- MobilePay Transactions Window Action -->
        <record id="action_mobilepay_transactions" model="ir.actions.act_window">
            <field name="name">MobilePay Transactions</field>
            <field name="res_model">payment.transaction</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('provider_id.code', '=', 'mobilepay')]</field>
            <field name="context">{
                'default_provider_id': False,
                'search_default_filter_authorized': True,
                'search_default_filter_pending': True
            }</field>
            <field name="help">View and manage all MobilePay payment transactions</field>
        </record>

        <!-- MobilePay Transactions Menu Item -->
        <menuitem id="menu_mobilepay_transactions"
                  name="MobilePay Transactions"
                  parent="account.menu_finance"
                  action="action_mobilepay_transactions"
                  sequence="55"
                  groups="account.group_account_readonly,account.group_account_invoice"/>
    </data>
</odoo>
