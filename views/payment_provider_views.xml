<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- MobilePay Payment Provider Form View -->
        <record id="payment_provider_form_mobilepay" model="ir.ui.view">
            <field name="name">payment.provider.form.mobilepay</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='capture_manually']" position="replace">
                    <!-- remove duplicate base field; keep custom capture settings in Configuration -->
                </xpath>
                <xpath expr="//group[@name='provider_credentials']" position="after">
                    <field name="show_mobilepay_fields" invisible="1"/>
                    <group name="mobilepay_credentials" 
                           invisible="not show_mobilepay_fields">
                        <field name="mobilepay_logic_version" readonly="1" 
                               font="bold" class="text-primary h5 font-weight-bold mb-3"/>
                        <group string="Test Environment Credentials" name="test_credentials"
                               invisible="state == 'enabled'">
                            <field name="mobilepay_test_merchant_serial" help="The 6-digit MSN (Merchant Serial Number) for the test unit."/>
                            <field name="mobilepay_test_client_id" help="The Client ID found in the Vipps Portal under Developer -> API Keys."/>
                            <field name="mobilepay_test_client_secret" password="True" help="The Client Secret found in the Vipps Portal."/>
                            <field name="mobilepay_test_subscription_key" password="True" help="The Ocp-Apim-Subscription-Key for the API product."/>
                            
                        </group>
                        <group string="Production Environment Credentials" name="prod_credentials"
                               invisible="state != 'enabled'">
                            <field name="mobilepay_prod_merchant_serial" help="The 6-digit MSN (Merchant Serial Number) for the production unit."/>
                            <field name="mobilepay_prod_client_id" help="The Client ID found in the Vipps Portal under Developer -> API Keys."/>
                            <field name="mobilepay_prod_client_secret" password="True" help="The Client Secret found in the Vipps Portal."/>
                            <field name="mobilepay_prod_subscription_key" password="True" help="The Ocp-Apim-Subscription-Key for the API product."/>
                        </group>
                        <group string="Webhook Configuration" name="webhook_config">
                            <field name="mobilepay_webhook_id"/>
                            <field name="mobilepay_webhook_secret" password="True"/>
                            <div class="oe_edit_only" colspan="2">
                                <button name="action_register_webhook" 
                                        string="Register Webhook" 
                                        type="object" 
                                        class="btn-primary me-2"
                                        invisible="mobilepay_webhook_id"/>
                                <button name="action_unregister_webhook" 
                                        string="Unregister Webhook" 
                                        type="object" 
                                        class="btn-secondary"
                                        invisible="not mobilepay_webhook_id"/>
                            </div>
                        </group>
                        
                        <group string="Diagnostic / Recovery Tools" name="diagnostic_tools">
                            <p class="text-muted small" colspan="2">
                                Use these tools to verify API connectivity and manage webhook registrations.
                            </p>
                            <button name="action_test_connection" 
                                    string="Test API Connection" 
                                    type="object" 
                                    class="btn-primary oe_edit_only"
                                    icon="fa-check-circle"
                                    help="Attempts to fetch an authentication token from the MobilePay API to verify credentials."/>
                            <button name="action_list_webhooks" 
                                    string="List All Active Webhooks" 
                                    type="object" 
                                    class="btn-link oe_edit_only"
                                    help="Logs all webhooks registered on the MobilePay server for this MSN."/>
                            <button name="action_unregister_all_webhooks" 
                                    string="FORCE CLEAN ALL WEBHOOKS" 
                                    type="object" 
                                    class="btn-danger oe_edit_only"
                                    confirm="Are you sure? This will remove ALL webhook registrations from MobilePay/Vipps for this MSN."/>
                            <button name="action_force_unregister_stored_webhook"
                                    string="Wipe Local Webhook Credentials"
                                    type="object"
                                    class="btn-secondary oe_edit_only"
                                    invisible="not mobilepay_webhook_id"
                                    help="Clears the Webhook ID and Secret from Odoo manually."/>
                        </group>
                        <group string="Configuration" name="mobilepay_config">
                            <div colspan="2" class="mb-3">
                                <a href="https://portal.vippsmobilepay.com/" target="_blank" class="btn btn-link px-0">
                                    <i class="fa fa-external-link"/> Open Vipps MobilePay Portal
                                </a>
                            </div>
                            <field name="is_published"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                        <group string="Payment Flow Settings" name="payment_flow">
                            <field name="capture_mode"
                                   help="Select how MobilePay should capture authorized payments: manually, automatically on delivery, or automatically after a delay."/>
                            <field name="auto_capture_delay"
                                   invisible="capture_mode != 'auto_delay'"
                                   help="Enter the number of hours to wait before automatically capturing the payment when Automatic Capture after Delay is selected."/>
                        </group>
                        <group string="Settlement &amp; Fees Reconciliation" name="settlement_reconciliation">
                            <field name="mobilepay_journal_id"
                                   attrs="{'required': [('code', '=', 'mobilepay')]}"/>
                            <field name="mobilepay_clearing_account_id"
                                   attrs="{'required': [('code', '=', 'mobilepay')]}"/>
                            <field name="mobilepay_fee_account_id"
                                   attrs="{'required': [('code', '=', 'mobilepay')]}"/>
                            <field name="mobilepay_fee_tax_id"/>
                            <field name="mobilepay_auto_post_settlements"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- MobilePay Payment Provider Tree View -->
        <record id="payment_provider_tree_mobilepay" model="ir.ui.view">
            <field name="name">payment.provider.tree.mobilepay</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="show_mobilepay_fields" column_invisible="True"/>
                    <field name="mobilepay_merchant_serial" 
                           invisible="not show_mobilepay_fields"/>
                    <field name="is_published"
                           invisible="not show_mobilepay_fields"/>
                    <field name="website_id"
                           invisible="not show_mobilepay_fields"
                           groups="website.group_multi_website"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
