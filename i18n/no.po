msgid "Failed to clean webhooks: %s"
msgstr "Kunne ikke rydde opp i webhooks: %s"

#. module: mobilepay_payment
msgid "No webhook ID stored to unregister."
msgstr "Ingen lagret webhook-ID å avregistrere."

#. module: mobilepay_payment
msgid "Webhook Forced Out"
msgstr "Webhook tvunget ut"

#. module: mobilepay_payment
msgid "Attempted to unregister stored ID and cleared local state."
msgstr "Forsøkte å avregistrere lagret ID og slettet lokal tilstand."

#. module: mobilepay_payment
msgid "Local State Cleared"
msgstr "Lokal tilstand slettet"

#. module: mobilepay_payment
msgid "API unregistration failed, but Odoo credentials were cleared."
msgstr "API-avregistrering mislyktes, men Odoo-legitimasjon ble slettet."

#. module: mobilepay_payment
msgid "Network error while connecting to MobilePay API: %s"
msgstr "Nettverksfeil ved tilkobling til MobilePay API: %s"

#. module: mobilepay_payment
msgid "Payment capture failed: %s"
msgstr "Betalingstrekk mislyktes: %s"


#. module: mobilepay_payment
msgid "Test API Connection"
msgstr "Test API-tilkobling"

#. module: mobilepay_payment
msgid "Connection Successful"
msgstr "Tilkobling vellykket"

#. module: mobilepay_payment
msgid "Successfully connected to the MobilePay API! Your credentials are valid."
msgstr "Vellykket tilkobling til MobilePay API! Dine legitimasjonsopplysninger er gyldige."

#. module: mobilepay_payment
msgid "Connection failed: %s"
msgstr "Tilkobling mislyktes: %s"

#. module: mobilepay_payment
msgid "Open Vipps MobilePay Portal"
msgstr "Åpne Vipps MobilePay-portalen"

#. module: mobilepay_payment
#: model:payment.provider,name:mobilepay_payment.payment_provider_mobilepay
msgid "Vipps MobilePay"
msgstr "Vipps MobilePay"

