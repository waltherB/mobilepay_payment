#. module: mobilepay_payment
#: model_terms:ir.ui.view,arch_db:mobilepay_payment.inline_form
msgid "Phone Number"
msgstr "Telefonnummer"

#. module: mobilepay_payment
#: model_terms:ir.ui.view,arch_db:mobilepay_payment.inline_form
msgid "Please enter a valid Danish phone number."
msgstr "Vennligst skriv inn et gyldig dansk telefonnummer."

#. module: mobilepay_payment
#: model_terms:ir.ui.view,arch_db:mobilepay_payment.inline_form
msgid "Enter your MobilePay phone number."
msgstr "Skriv inn ditt MobilePay-telefonnummer."

#. module: mobilepay_payment
#: model_terms:ir.ui.view,arch_db:mobilepay_payment.inline_form
msgid "Pay with MobilePay"
msgstr "Betal med MobilePay"

#. module: mobilepay_payment
#. odoo-javascript
#: code:addons/mobilepay_payment/static/src/js/payment_form.js:0
msgid "Invalid phone number"
msgstr "Ugyldig telefonnummer"

#. module: mobilepay_payment
#: model:ir.model.fields,field_description:mobilepay_payment.field_payment_provider__code
msgid "Code"
msgstr "Kode"

#. module: mobilepay_payment
#: model:payment.provider,name:mobilepay_payment.payment_provider_mobilepay
msgid "MobilePay"
msgstr "MobilePay"

#. module: mobilepay_payment
#: code:addons/mobilepay_payment/models/payment_transaction.py:0
msgid "Payment initiation failed: %s"
msgstr "Betalingsinitiering mislyktes: %s"

#. module: mobilepay_payment
#: code:addons/mobilepay_payment/models/payment_transaction.py:0
msgid "Only confirmed transactions can be refunded."
msgstr "Kun bekreftede transaksjoner kan refunderes."

#. module: mobilepay_payment
#: code:addons/mobilepay_payment/models/payment_transaction.py:0
msgid "Refund failed: %s"
msgstr "Refusjon mislyktes: %s"

#. module: mobilepay_payment
#: code:addons/mobilepay_payment/models/payment_transaction.py:0
msgid "Cancellation failed: %s"
msgstr "Kansellering mislyktes: %s"

#. module: mobilepay_payment
#: model:payment.provider,field_description:mobilepay_payment.field_payment_provider__capture_mode
msgid "Capture Flow"
msgstr "Trekkflyt"

#. module: mobilepay_payment
#: model:payment.provider,field_selection:mobilepay_payment.field_payment_provider__capture_mode
msgid "Manual Capture"
msgstr "Manuelt trekk"

#. module: mobilepay_payment
#: model:payment.provider,field_selection:mobilepay_payment.field_payment_provider__capture_mode
msgid "Capture on Delivery"
msgstr "Trekk ved levering"

#. module: mobilepay_payment
#: model:payment.provider,field_selection:mobilepay_payment.field_payment_provider__capture_mode
msgid "Automatic Capture after Delay"
msgstr "Automatisk trekk etter forsinkelse"

#. module: mobilepay_payment
#: model:ir.ui.view,arch_db:mobilepay_payment.payment_provider_form_mobilepay
msgid "Choose whether payments are captured manually, automatically after a delay, or automatically on delivery."
msgstr "Velg om betalinger skal trekkes manuelt, automatisk etter en forsinkelse, eller automatisk ved levering."

#. module: mobilepay_payment
#: model:ir.ui.view,arch_db:mobilepay_payment.payment_provider_form_mobilepay
msgid "Delay in hours before automatic capture when the selected capture flow is Automatic Capture after Delay."
msgstr "Forsinkelse i timer før automatisk trekk når valgt trekkflyt er Automatisk trekk etter forsinkelse."


#. module: mobilepay_payment
msgid "Here, you can pay with MobilePay"
msgstr "Her kan du betale med MobilePay"

#. module: mobilepay_payment
msgid "Please enter a valid Danish phone number (8 digits, optionally with +45)."
msgstr "Vennligst skriv inn et gyldig dansk telefonnummer (8 sifre, eventuelt med +45)."

#. module: mobilepay_payment
msgid "Webhook Registration Successful"
msgstr "Webhook-registrering vellykket"

#. module: mobilepay_payment
msgid "Webhook Registration Failed"
msgstr "Webhook-registrering mislyktes"

